rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque planning est rangé sous /spaces/{space}, où {space} est une
    // empreinte de 64 caractères dérivée du code d'accès.
    // Lister la collection « spaces » est interdit : sans le code, on ne
    // peut ni trouver ni lire les données.
    match /spaces/{space} {
      allow get: if true;
      allow list: if false;
      allow create: if space.size() == 64
                    && request.resource.data.keys().hasOnly(['createdAt', 'v']);
      allow update: if false;
      allow delete: if true;

      function spaceExists() {
        return exists(/databases/$(database)/documents/spaces/$(space));
      }

      match /members/{memberId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validMember(request.resource.data);
        allow delete: if true;
      }

      match /stays/{stayId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validStay(request.resource.data);
        allow delete: if true;
      }

      // Mémo : code wifi (document « wifi » uniquement)
      match /memo/{docId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && docId == 'wifi'
          && request.resource.data.keys().hasOnly(['code', 'updatedBy', 'updatedAt'])
          && request.resource.data.code is string && request.resource.data.code.size() <= 100;
        allow delete: if true;
      }

      // Mémo : fiches « Bon à savoir » (texte ou contact)
      match /infos/{infoId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validInfo(request.resource.data);
        allow delete: if true;
      }

      // Agenda › Restos & bars : adresses (avec la miniature de couverture)
      match /places/{placeId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validPlace(request.resource.data);
        allow delete: if true;
      }

      // Restos & bars : une note par personne et par adresse (identifiant « adresse_personne »)
      match /ratings/{ratingId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validRating(request.resource.data)
          && ratingId == request.resource.data.placeId + '_' + request.resource.data.memberId;
        allow delete: if true;
      }

      // Restos & bars : miniature d'une photo (≈ 25 Ko). Une photo ne se modifie pas.
      match /placePhotos/{photoId} {
        allow read: if spaceExists();
        allow create: if spaceExists()
          && request.resource.data.keys().hasOnly(['placeId', 'thumb', 'authorId', 'authorName', 'createdAt'])
          && request.resource.data.placeId is string && request.resource.data.placeId.size() <= 64
          && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 36000
          && request.resource.data.thumb.matches('^data:image/(webp|jpeg);base64,.*');
        allow update: if false;
        allow delete: if true;
      }

      // Restos & bars : photo complète (≈ 200 Ko), chargée seulement à l'ouverture.
      match /placePhotoFull/{photoId} {
        allow read: if spaceExists();
        allow create: if spaceExists()
          && request.resource.data.keys().hasOnly(['placeId', 'data'])
          && request.resource.data.placeId is string && request.resource.data.placeId.size() <= 64
          && request.resource.data.data is string && request.resource.data.data.size() <= 280000
          && request.resource.data.data.matches('^data:image/(webp|jpeg);base64,.*');
        allow update: if false;
        allow delete: if true;
      }

      // Mémo : points d'attention
      match /notes/{noteId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validNote(request.resource.data);
        allow delete: if true;
      }

      // Mémo : points des check-lists « En arrivant » / « En partant »
      match /checkItems/{itemId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validItem(request.resource.data);
        allow delete: if true;
      }

      // Mémo : coches d'une check-list pour un séjour
      match /checks/{checkId} {
        allow read: if spaceExists();
        allow create, update: if spaceExists() && validCheck(request.resource.data);
        allow delete: if true;
      }
    }

    function validNote(d) {
      return d.keys().hasOnly(['text', 'authorId', 'authorName', 'resolved', 'resolvedAt', 'createdAt', 'updatedAt'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && d.resolved is bool;
    }

    function validInfo(d) {
      return d.keys().hasOnly(['kind', 'text', 'name', 'phones', 'order', 'createdAt', 'updatedAt'])
        && d.kind in ['text', 'contact']
        && d.text is string && d.text.size() <= 1000
        && d.name is string && d.name.size() <= 80
        && d.phones is list && d.phones.size() <= 5
        && d.order is number
        && ((d.kind == 'text' && d.text.size() > 0)
            || (d.kind == 'contact' && d.name.size() > 0 && d.phones.size() > 0));
    }

    function optNumber(x) { return x == null || x is number; }
    function optString(x, n) { return x == null || (x is string && x.size() <= n); }

    function validPlace(d) {
      return d.keys().hasOnly(['name', 'type', 'city', 'address', 'price', 'intro', 'lat', 'lon', 'geo', 'km',
                               'authorId', 'authorName', 'coverId', 'cover', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.type in ['resto', 'bar', 'cafe', 'cidrerie', 'autre']
        && d.city is string && d.city.size() <= 60
        && d.address is string && d.address.size() <= 500
        && d.price is int && d.price >= 0 && d.price <= 3
        && d.intro is string && d.intro.size() <= 600
        && optNumber(d.get('lat', null)) && optNumber(d.get('lon', null)) && optNumber(d.get('km', null))
        && optString(d.get('geo', null), 10)
        && optString(d.get('authorId', null), 64) && optString(d.get('authorName', null), 40)
        && optString(d.get('coverId', null), 64) && optString(d.get('cover', null), 36000);
    }

    function validRating(d) {
      return d.keys().hasOnly(['placeId', 'memberId', 'memberName', 'stars', 'comment', 'updatedAt'])
        && d.placeId is string && d.placeId.size() > 0 && d.placeId.size() <= 64
        && d.memberId is string && d.memberId.size() > 0 && d.memberId.size() <= 64
        && d.memberName is string && d.memberName.size() <= 40
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.comment is string && d.comment.size() <= 500;
    }

    function validItem(d) {
      return d.keys().hasOnly(['list', 'text', 'order', 'createdAt'])
        && d.list in ['arrive', 'depart']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && d.order is number;
    }

    function validCheck(d) {
      return d.keys().hasOnly(['list', 'stayId', 'checked', 'byId', 'byName', 'updatedAt'])
        && d.list in ['arrive', 'depart']
        && d.checked is map && d.checked.size() <= 200;
    }

    function validMember(d) {
      return d.keys().hasOnly(['name', 'color', 'order', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.color is string && d.color.size() <= 20
        && d.order is number;
    }

    function isDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validStay(d) {
      return d.keys().hasOnly(['memberId', 'start', 'end', 'note', 'guestIds', 'guests', 'createdAt', 'updatedAt'])
        && d.memberId is string && d.memberId.size() > 0 && d.memberId.size() <= 64
        && isDate(d.start) && isDate(d.end) && d.start <= d.end
        && d.note is string && d.note.size() <= 500
        && (!('guestIds' in d) || (d.guestIds is list && d.guestIds.size() <= 30))
        && (!('guests' in d) || (d.guests is list && d.guests.size() <= 30));
    }
  }
}
